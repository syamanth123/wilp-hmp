# =============================================================================
# HMP — Production environment template
# =============================================================================
# Copy to `.env` (or `.env.production`) on the server and replace every
# <PLACEHOLDER>. NO real values live in this file — it is safe to commit.
#
# The web server AND the worker process read the SAME file. The worker
# additionally requires WORKERS_ENABLED=true and its own systemd unit / pm2
# entry (see the WORKER PROCESS section at the bottom).
#
# Every variable below is verified against an actual `process.env` read in the
# code. (The older root `.env.example` is out of date — it lists some vars the
# code no longer reads, e.g. S3_BUCKET / AUTH_MODE / LOG_LEVEL / ERP_* / SSO_*,
# and omits several it does. Use THIS file for production.)
# =============================================================================


# =============================================================================
# REQUIRED — the app will not run correctly without these
# =============================================================================

# --- Database (RDS PostgreSQL 16) -------------------------------------------
# Prisma's only datasource. Keep ?schema=public; use SSL against RDS.
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?schema=public&sslmode=require"

# --- Auth (NextAuth v5) ------------------------------------------------------
# Public origin of the app (scheme + host, no trailing slash). https in prod;
# for bare-IP testing use http://<EC2_PUBLIC_IP>:3000.
NEXTAUTH_URL="https://<YOUR_DOMAIN>"
# Session/JWT signing secret. Generate a FRESH value — do NOT reuse the dev one:
#   openssl rand -base64 32
NEXTAUTH_SECRET="<GENERATE_WITH_openssl_rand_base64_32>"

# --- App base URL (absolute email links) ------------------------------------
# Prefixed onto notification links in EMAIL so they're clickable in a mail
# client. Normally identical to NEXTAUTH_URL; if unset the code falls back to
# NEXTAUTH_URL.
APP_BASE_URL="https://<YOUR_DOMAIN>"

# --- Redis (BullMQ queues + rate limiting) ----------------------------------
# Local redis for the pilot, or an ElastiCache endpoint.
REDIS_URL="redis://<REDIS_HOST>:6379"

# --- S3 object storage (real AWS) -------------------------------------------
S3_REGION="<AWS_REGION>"                 # e.g. ap-south-1
# NOTE: storage.ts currently ALWAYS sets explicit credentials, so an empty key
# disables the IAM instance-role chain — supply STATIC keys here. (To use an
# instance role instead, storage.ts must be changed to omit `credentials` when
# these are unset; not done yet.)
S3_ACCESS_KEY="<IAM_ACCESS_KEY_ID>"
S3_SECRET_KEY="<IAM_SECRET_ACCESS_KEY>"
# Two logical buckets. Use two real buckets, or point BOTH at the same bucket
# (keys are prefixed, so one bucket is fine for a pilot).
HANDOUT_ATTACHMENTS_BUCKET="<ATTACHMENTS_BUCKET_NAME>"
LMS_EXPORTS_BUCKET="<LMS_EXPORTS_BUCKET_NAME>"
# S3_ENDPOINT is intentionally absent here — see "DO NOT SET" at the bottom.

# --- Email (SMTP) ------------------------------------------------------------
SMTP_HOST="<SMTP_HOST>"
SMTP_PORT="587"
SMTP_USER="<SMTP_USER>"
SMTP_PASS="<SMTP_PASSWORD>"
SMTP_FROM="HMP <no-reply@<YOUR_DOMAIN>>"

# --- PDF export (LibreOffice) ------------------------------------------------
# Path to the soffice binary. After `apt install libreoffice` on Ubuntu, soffice
# is on PATH so "soffice" works. Required for every PDF download (else 503).
SOFFICE_BIN="soffice"

# --- Runtime -----------------------------------------------------------------
NODE_ENV="production"


# =============================================================================
# FEATURE-GATED — set only if you use the feature
# =============================================================================

# --- AI (faculty recommendation, handout quality report) --------------------
AI_PROVIDER="anthropic"                  # openai | anthropic
ANTHROPIC_API_KEY="<ANTHROPIC_KEY__if_AI_PROVIDER=anthropic>"
OPENAI_API_KEY="<OPENAI_KEY__if_AI_PROVIDER=openai>"
AI_MONTHLY_BUDGET_USD="200"              # soft cap; over-budget → admin alert, AI stays on

# --- Taxila LMS publish ------------------------------------------------------
# Set BOTH for Mode A (HTTP publish). Leave empty for Mode B (manual export ZIP).
TAXILA_API_URL=""
TAXILA_API_TOKEN=""

# --- Cron (reminder endpoints) ----------------------------------------------
# Bearer secret required by /api/cron/*. Generate one and configure it in the
# cron caller (systemd timer / external scheduler).
CRON_SECRET="<GENERATE_A_RANDOM_SECRET>"

# --- Corpus import (admin bulk handout import) ------------------------------
HMP_CORPUS_DIR="<ABSOLUTE_PATH_TO_CORPUS_DIR__or_leave_unset>"
CORPUS_IMPORT_MAX_BYTES="8388608"        # 8 MB; keep ≤ the 10 MB server-action body limit


# =============================================================================
# WORKER PROCESS
# =============================================================================
# The web server does NOT process background jobs (notifications, AI). With
# WORKERS_ENABLED=true the web app ENQUEUES jobs to Redis; a SEPARATE worker
# process (apps/web/src/workers/start.ts) consumes them. Run that worker under
# its own systemd unit or pm2 entry, reading THIS SAME file. If you leave the
# worker off, set nothing extra — the app falls back to running jobs inline
# (synchronously, blocking the request), which is fine for very low volume.
WORKERS_ENABLED="true"


# =============================================================================
# DO NOT SET IN PRODUCTION
# =============================================================================
# S3_ENDPOINT — MinIO / local-dev ONLY. Setting it points the AWS SDK at a
# custom endpoint instead of real AWS S3. Leave UNSET for AWS.
#   S3_ENDPOINT=
